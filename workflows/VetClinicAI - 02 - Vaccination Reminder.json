      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.reminderMessage }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1296,
        -192
      ],
      "id": "989dd3e2-092a-4d46-b4eb-881d3e7d2c90",
