      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -16,
        -128
      ],
      "id": "e53a0c9f-f4d5-49ef-963e-7e7a5a564939",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    CASE\n        WHEN EXISTS (\n            SELECT 1\n            FROM dbo.VaccinationReminderLog\n            WHERE VaccinationId = $1\n              AND DueDate = CAST($2 AS DATE)\n              AND Channel = N'Discord'\n        )\n        THEN 1\n        ELSE 0\n    END AS AlreadySent;\n",
        "options": {
          "queryReplacement": "=\t{{ $json.VaccinationId }},{{ $json.NextDueDate }}"
        }
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.2,
      "position": [
        800,
        -64
      ],
      "id": "6e24f584-7c87-45c7-b866-46b81ab20d7f",
      "name": "Check Reminder History"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "27f07754-4cef-419a-a7c7-9925d463f739",
              "leftValue": "={{ $json.AlreadySent }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        992,
        -48
      ],
      "id": "0c6edeaa-e981-4fc8-bb5b-6f5d24059220",
      "name": "Is New Reminder"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "86a2d6de-1f7c-40ea-8838-e19fd4b1b49c",
              "name": "reminderMessage",
              "value": "={{ $('Prepare Vaccination Reminder').item.json.reminderMessage }}",
              "type": "string"
            },
            {
              "id": "334e26fb-20fb-44c7-9c4d-495b381f966b",
              "name": "VaccinationId",
              "value": "={{ $('Prepare Vaccination Reminder').item.json.VaccinationId }}",
              "type": "number"
            },
            {
              "id": "5e4242d3-46db-4e23-85b9-ff3b782c0509",
              "name": "NextDueDate",
              "value": "={{ $('Prepare Vaccination Reminder').item.json.NextDueDate }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1120,
        -192
      ],
      "id": "1f6c1223-372f-415f-ba5f-66e648c7f558",
      "name": "Restore Reminder Data"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nIF $3 = 1\nBEGIN\n    IF NOT EXISTS (\n        SELECT 1\n        FROM dbo.VaccinationReminderLog\n        WHERE VaccinationId = $1\n          AND DueDate = CAST($2 AS DATE)\n          AND Channel = N'Discord'\n    )\n    BEGIN\n        INSERT INTO dbo.VaccinationReminderLog\n            (VaccinationId, DueDate, Channel)\n        VALUES\n            ($1, CAST($2 AS DATE), N'Discord');\n\n        SELECT N'Logged' AS LogStatus;\n    END\n    ELSE\n    BEGIN\n        SELECT N'Already logged' AS LogStatus;\n    END\nEND\nELSE\nBEGIN\n    SELECT N'Discord send failed' AS LogStatus;\nEND;\n",
        "options": {
          "queryReplacement": "={{ $('Restore Reminder Data').item.json.VaccinationId }},{{ $('Restore Reminder Data').item.json.NextDueDate }},{{ $json.success ? 1 : 0 }}"
        }
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.2,
      "position": [
        1344,
        -16
      ],
      "id": "1fc6c549-0640-4cad-bbd9-c9cb8339df2b",
      "name": "Log Sent Reminder"
    }
  ],
