              "id": "d45ad1b4-ada4-4c87-affa-5bfd53018616",
              "name": "reminderMessage",
              "value": "={{ `Hello ${$json.CustomerName}, this is a reminder from VetClinicAI. ${$json.PetName} has an upcoming ${$json.VaccineName} vaccination in ${$json.DaysUntilDue} day(s). Please contact the clinic to confirm the appointment.` }}",
              "type": "string"
            }
