{
  "name": "VetClinicAI - 02 - Vaccination Reminder",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        48
      ],
      "id": "d7072457-c7bb-4ba4-9482-97e788d6b110",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n    v.VaccinationId,\n    c.CustomerId,\n    c.FullName AS CustomerName,\n    p.PetId,\n    p.PetName,\n    v.VaccineName,\n    v.NextDueDate,\n    DATEDIFF(\n        DAY,\n        CAST(GETDATE() AS DATE),\n        v.NextDueDate\n    ) AS DaysUntilDue\nFROM dbo.Vaccinations AS v\nINNER JOIN dbo.Pets AS p\n    ON v.PetId = p.PetId\nINNER JOIN dbo.Customers AS c\n    ON p.CustomerId = c.CustomerId\nORDER BY v.NextDueDate;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.2,
      "position": [
        224,
        48
      ],
      "id": "5ed51805-d678-485a-be27-48e65db30efa",
      "name": "Microsoft SQL"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "2bfbe927-7120-41b6-a53a-b705300c903d",
              "leftValue": "={{ $json.DaysUntilDue }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "dcad1892-7d38-4adb-8e38-5f205afacd3f",
              "leftValue": "={{ $json.DaysUntilDue }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        448,
        48
      ],
      "id": "5d8c3d37-f82d-41f0-bcbc-296b519284ff",
