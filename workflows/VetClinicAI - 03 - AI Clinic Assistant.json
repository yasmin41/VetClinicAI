    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Get, add and update data in Microsoft SQLReturns upcoming pet vaccinations due within the next 7 days from the VetClinicAI SQL Server database. Use this tool when the user asks about upcoming vaccinations, vaccine due dates, or pets needing vaccination soon. This tool only reads data and does not modify the database.\n Copy",
        "operation": "executeQuery",
        "query": "\nSELECT\n    p.PetName,\n    p.Species,\n    v.VaccineName,\n    CONVERT(VARCHAR(10), v.NextDueDate, 23) AS NextDueDate,\n    DATEDIFF(\n        DAY,\n        CAST(GETDATE() AS DATE),\n        CAST(v.NextDueDate AS DATE)\n    ) AS DaysUntilDue\nFROM dbo.Vaccinations AS v\nINNER JOIN dbo.Pets AS p\n    ON v.PetId = p.PetId\nWHERE\n    v.NextDueDate >= CAST(GETDATE() AS DATE)\n    AND v.NextDueDate < DATEADD(DAY, 8, CAST(GETDATE() AS DATE))\nORDER BY v.NextDueDate ASC;\n",
        "options": {}
      },
